{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "biometrics": {
      "type": "object",
      "properties": {
        "body_weight_kg": { "type": ["number", "null"] },
        "step_count": { "type": ["integer", "null"] },
        "resting_heart_rate": { "type": ["integer", "null"] },
        "sleep_hours": { "type": ["number", "null"] }
      },
      "required": ["body_weight_kg", "step_count", "resting_heart_rate", "sleep_hours"],
      "additionalProperties": false
    },
    "nutrition": {
      "type": "object",
      "properties": {
        "protocol": { "type": ["string", "null"] },
        "total_calories": { "type": ["integer", "null"] },
        "protein_grams": { "type": ["integer", "null"] },
        "adherence": { "type": ["boolean", "null"] }
      },
      "required": ["protocol", "total_calories", "protein_grams", "adherence"],
      "additionalProperties": false
    },
    "training": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "exercise": { "type": "string" },
          "weight_kg": { "type": ["number", "null"] },
          "sets": { "type": "integer" },
          "reps": { "type": "integer" },
          "notes": { "type": ["string", "null"] }
        },
        "required": ["exercise", "weight_kg", "sets", "reps", "notes"],
        "additionalProperties": false
      }
    },
    "flags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Log any anomalies, fatigue warnings, or explicit performance dips mentioned in the text."
    }
  },
  "required": ["timestamp", "biometrics", "nutrition", "training", "flags"],
  "additionalProperties": false
}
